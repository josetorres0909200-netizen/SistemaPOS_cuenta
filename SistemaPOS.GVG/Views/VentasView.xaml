<UserControl x:Class="SistemaPOS.Desktop.Views.VentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8F9FA"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <!-- Área de Productos -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <TextBlock Grid.Row="0" Text="🛒 Punto de Venta" FontSize="28" FontWeight="Bold" Foreground="#1a1a1a" Margin="0,0,0,15"/>

            <!-- Búsqueda -->
            <Border Grid.Row="1" Background="White" Padding="15" Margin="0,0,0,15" Effect="{StaticResource ShadowEffect}">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="txtBusquedaProducto" Width="300" Height="40" Padding="12,0" 
                             VerticalContentAlignment="Center" FontSize="14"
                             Foreground="#333333" BorderThickness="1" BorderBrush="#E0E0E0"/>

                    <Button Content="🔍 Buscar" Width="100" Height="40" Margin="10,0,0,0"
                            Background="#1A73E8" Foreground="White" FontWeight="Bold" BorderThickness="0"
                            Click="BtnBuscarProducto_Click"/>

                    <Button Content="🔄 Limpiar" Width="100" Height="40" Margin="10,0,0,0"
                            Background="#6C757D" Foreground="White" FontWeight="Bold" BorderThickness="0"
                            Click="BtnLimpiarBusqueda_Click"/>
                </StackPanel>
            </Border>

            <!-- Grid de Productos Disponibles -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="icProductosDisponibles" Padding="0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="180" Height="220" Margin="0,0,12,12"
                                    Background="White" BorderThickness="1" BorderBrush="#E8E8E8"
                                    Effect="{StaticResource ShadowEffect}">

                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Categoría -->
                                    <Border Grid.Row="0" Background="#E3F2FD" Padding="6,3">
                                        <TextBlock Text="{Binding Categoria}" FontSize="10" Foreground="#1A73E8" FontWeight="Bold"/>
                                    </Border>

                                    <!-- Descripción -->
                                    <TextBlock Grid.Row="1" Text="{Binding Descripcion}" FontSize="12" FontWeight="Bold"
                                               Foreground="#1a1a1a" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>

                                    <!-- Precio -->
                                    <TextBlock Grid.Row="2" Text="{Binding PrecioVenta, StringFormat='${0:F2}'}"
                                               FontSize="14" FontWeight="Bold" Foreground="#28A745" Margin="0,8,0,0"/>

                                    <!-- Stock -->
                                    <TextBlock Grid.Row="3" Text="{Binding Stock, StringFormat='Stock: {0:F0}'}"
                                               FontSize="10" Foreground="#999999" Margin="0,4,0,0"/>

                                    <!-- Botón Agregar -->
                                    <Button Grid.Row="5" Content="➕ Agregar" Padding="8,6" Margin="0,8,0,0"
                                            Background="#28A745" Foreground="White" FontWeight="Bold" BorderThickness="0"
                                            Click="BtnAgregarProducto_Click" Tag="{Binding IdProducto}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Panel de Carrito -->
        <Border Grid.Column="1" Background="White" Margin="15,0,0,0" Effect="{StaticResource ShadowEffect}">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Encabezado Carrito -->
                <Border Grid.Row="0" Background="#1A73E8" Padding="15">
                    <TextBlock Text="🛒 Carrito de Compra" FontSize="16" FontWeight="Bold" Foreground="White"/>
                </Border>

                <!-- Lista de Artículos -->
                <DataGrid Grid.Row="1" x:Name="dgCarrito" AutoGenerateColumns="False" 
                          Background="White" RowBackground="White" GridLinesVisibility="None"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          Margin="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Descripcion}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="50" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnitario, StringFormat='${0:F2}'}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding Subtotal, StringFormat='${0:F2}'}" Width="70" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Resumen y Botones -->
                <StackPanel Grid.Row="2" Background="#F8F9FA" Margin="15">
                    <!-- Subtotal -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Subtotal:" FontSize="12" Foreground="#666666"/>
                        <TextBlock Grid.Column="1" x:Name="lblSubtotal" Text="$0.00" FontSize="12" FontWeight="Bold" Foreground="#333333"/>
                    </Grid>

                    <!-- Impuesto -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Impuesto:" FontSize="12" Foreground="#666666"/>
                        <TextBlock Grid.Column="1" x:Name="lblImpuesto" Text="$0.00" FontSize="12" FontWeight="Bold" Foreground="#333333"/>
                    </Grid>

                    <!-- Total -->
                    <Border Background="#1A73E8" Padding="10" Margin="0,10,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TOTAL:" FontSize="14" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Grid.Column="1" x:Name="lblTotal" Text="$0.00" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        </Grid>
                    </Border>

                    <!-- Botones de Acción -->
                    <Button x:Name="btnCobrar" Content="💵 Cobrar" Height="40" 
                            Background="#28A745" Foreground="White" FontWeight="Bold" BorderThickness="0"
                            Margin="0,0,0,8" Click="BtnCobrar_Click"/>

                    <Button Content="❌ Cancelar Venta" Height="40"
                            Background="#DC3545" Foreground="White" FontWeight="Bold" BorderThickness="0"
                            Click="BtnCancelarVenta_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>