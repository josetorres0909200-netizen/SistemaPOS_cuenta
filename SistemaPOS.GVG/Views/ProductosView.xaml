<UserControl x:Class="SistemaPOS.Desktop.Views.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#fabfb7"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📦 Inventario de Productos" FontSize="32" FontWeight="Bold" Foreground="#1a1a1a"/>
            <TextBlock x:Name="lblProductoCount" Text="Cargando productos..." FontSize="14" Foreground="#666666" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Barra de búsqueda y filtros -->
        <Border Grid.Row="1" Background="White" Padding="15" Margin="0,0,0,20" Effect="{StaticResource ShadowEffect}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Búsqueda por código o descripción -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBox x:Name="txtBusqueda" 
                             Width="300" Height="40" 
                             Padding="12,0" 
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             Foreground="#333333"
                             BorderThickness="1"
                             BorderBrush="#E0E0E0"/>

                    <Button x:Name="btnBuscar" Content="🔍 Buscar" 
                            Width="100" Height="40" 
                            Margin="10,0,0,0"
                            Background="#1A73E8" 
                            Foreground="White" 
                            FontWeight="Bold" 
                            BorderThickness="0"
                            Click="BtnBuscar_Click"/>
                </StackPanel>

                <!-- Botones de acción -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                    <Button x:Name="btnNuevo" Content="➕ Nuevo Artículo" 
                            Height="40" 
                            Padding="15,0"
                            Background="#28A745" 
                            Foreground="White" 
                            FontWeight="Bold" 
                            BorderThickness="0"
                            Click="BtnNuevo_Click"/>
                </StackPanel>

                <!-- Actualizar -->
                <Button Grid.Column="2" Content="🔄 Actualizar" 
                        Height="40" 
                        Padding="15,0"
                        Margin="10,0,0,0"
                        Background="#6C757D" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        BorderThickness="0"
                        Click="BtnActualizar_Click"/>
            </Grid>
        </Border>

        <!-- Grid de productos (Cards) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icProductos" Padding="0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Card de producto -->
                        <Border Width="280" Height="320" Margin="0,0,15,15" 
                                Background="White" 
                                BorderThickness="1" BorderBrush="#E8E8E8"
                                Effect="{StaticResource ShadowEffect}">

                            <Grid Margin="15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Badge de categoría -->
                                <Border Grid.Row="0" Background="#E3F2FD" 
                                        Padding="8,4" Width="Auto" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Categoria}" FontSize="11" Foreground="#1A73E8" FontWeight="Bold"/>
                                </Border>

                                <!-- Código de barras -->
                                <TextBlock Grid.Row="1" Text="{Binding CodigoBarras}" 
                                           FontSize="12" Foreground="#999999" Margin="0,8,0,0"/>

                                <!-- Descripción (Título) -->
                                <TextBlock Grid.Row="2" Text="{Binding Descripcion}" 
                                           FontSize="16" FontWeight="Bold" Foreground="#1a1a1a"
                                           Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           MaxHeight="45"/>

                                <!-- Detalles -->
                                <Grid Grid.Row="3" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Acabado" FontSize="10" Foreground="#999999"/>
                                        <TextBlock Text="{Binding Acabado}" FontSize="12" FontWeight="Bold" Foreground="#333333"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Tamaño" FontSize="10" Foreground="#999999"/>
                                        <TextBlock Text="{Binding Tamanio}" FontSize="12" FontWeight="Bold" Foreground="#333333"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Precios -->
                                <Border Grid.Row="4" Background="#F0F0F0" Padding="10" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Costo" FontSize="10" Foreground="#666666"/>
                                            <TextBlock Text="{Binding PrecioCosto, StringFormat='${0:F2}'}" 
                                                       FontSize="13" FontWeight="Bold" Foreground="#FF6B6B"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Precio" FontSize="10" Foreground="#666666"/>
                                            <TextBlock Text="{Binding PrecioVenta, StringFormat='${0:F2}'}" 
                                                       FontSize="13" FontWeight="Bold" Foreground="#28A745"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Stock -->
                                <Border Grid.Row="5" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Stock Disponible" FontSize="10" Foreground="#666666"/>
                                        <ProgressBar Height="6" Margin="0,4,0,0" 
                                                     Foreground="#1A73E8" 
                                                     Maximum="100" 
                                                     Value="{Binding Stock}"/>
                                        <TextBlock Text="{Binding Stock, StringFormat='Unidades: {0:F0}'}" 
                                                   FontSize="12" FontWeight="Bold" Foreground="#333333" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Botones de acción -->
                                <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                                    <Button Content="✏️ Editar" Padding="8,6" 
                                            Background="#FFC107" Foreground="White" 
                                            FontWeight="Bold" BorderThickness="0"
                                            Margin="0,0,5,0"
                                            Click="BtnEditar_Click"
                                            Tag="{Binding}"/>

                                    <Button Content="🗑️ Eliminar" Padding="8,6" 
                                            Background="#DC3545" Foreground="White" 
                                            FontWeight="Bold" BorderThickness="0"
                                            Margin="5,0,0,0"
                                            Click="BtnEliminar_Click"
                                            Tag="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
