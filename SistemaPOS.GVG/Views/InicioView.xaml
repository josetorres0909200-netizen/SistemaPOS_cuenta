<UserControl x:Class="SistemaPOS.Desktop.Views.InicioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8F9FA"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Encabezado -->
            <StackPanel Margin="0,0,0,30">
                <TextBlock Text="🏠 Panel de Control" FontSize="36" FontWeight="Bold" Foreground="#1a1a1a"/>
                <TextBlock Text="Bienvenido al Sistema de Punto de Venta" FontSize="16" Foreground="#666666" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- Tarjetas de Resumen -->
            <Grid Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Ventas Hoy -->
                <Border Grid.Column="0" Background="White" Padding="20" Margin="0,0,15,0" Effect="{StaticResource ShadowEffect}">
                    <StackPanel>
                        <TextBlock Text="🛒 Ventas Hoy" FontSize="14" Foreground="#666666" FontWeight="Bold"/>
                        <TextBlock Text="$0.00" FontSize="28" FontWeight="Bold" Foreground="#1A73E8" Margin="0,10,0,0"/>
                        <TextBlock Text="0 transacciones" FontSize="12" Foreground="#999999" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Productos en Stock -->
                <Border Grid.Column="1" Background="White" Padding="20" Margin="0,0,15,0" Effect="{StaticResource ShadowEffect}">
                    <StackPanel>
                        <TextBlock Text="📦 Stock Total" FontSize="14" Foreground="#666666" FontWeight="Bold"/>
                        <TextBlock x:Name="lblTotalProductos" Text="0" FontSize="28" FontWeight="Bold" Foreground="#28A745" Margin="0,10,0,0"/>
                        <TextBlock Text="artículos disponibles" FontSize="12" Foreground="#999999" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Clientes Registrados -->
                <Border Grid.Column="2" Background="White" Padding="20" Margin="0,0,15,0" Effect="{StaticResource ShadowEffect}">
                    <StackPanel>
                        <TextBlock Text="👥 Clientes" FontSize="14" Foreground="#666666" FontWeight="Bold"/>
                        <TextBlock x:Name="lblTotalClientes" Text="0" FontSize="28" FontWeight="Bold" Foreground="#FF9800" Margin="0,10,0,0"/>
                        <TextBlock Text="clientes activos" FontSize="12" Foreground="#999999" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Estado Caja -->
                <Border Grid.Column="3" Background="White" Padding="20" Effect="{StaticResource ShadowEffect}">
                    <StackPanel>
                        <TextBlock Text="💵 Estado Caja" FontSize="14" Foreground="#666666" FontWeight="Bold"/>
                        <TextBlock x:Name="lblEstadoCaja" Text="Cerrada" FontSize="28" FontWeight="Bold" Foreground="#F44336" Margin="0,10,0,0"/>
                        <TextBlock Text="caja del sistema" FontSize="12" Foreground="#999999" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Acciones Rápidas -->
            <StackPanel Margin="0,0,0,30">
                <TextBlock Text="⚡ Acciones Rápidas" FontSize="18" FontWeight="Bold" Foreground="#1a1a1a" Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="🛒 Nueva Venta" Height="60" Margin="0,0,15,0" 
                            Background="#1A73E8" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0"/>

                    <Button Grid.Column="1" Content="👥 Nuevo Cliente" Height="60" Margin="0,0,15,0"
                            Background="#28A745" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0"/>

                    <Button Grid.Column="2" Content="💵 Abrir Caja" Height="60"
                            Background="#FF9800" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0"/>
                </Grid>
            </StackPanel>

            <!-- Información del Sistema -->
            <Border Background="#E3F2FD" Padding="20" Effect="{StaticResource ShadowEffect}">
                <StackPanel>
                    <TextBlock Text="ℹ️ Información del Sistema" FontSize="16" FontWeight="Bold" Foreground="#1A73E8" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Negocio:" FontWeight="Bold" Foreground="#333333"/>
                        <TextBlock Grid.Column="1" Text="Pinturas El Gordo's" Foreground="#666666"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Ubicación:" FontWeight="Bold" Foreground="#333333"/>
                        <TextBlock Grid.Column="1" Text="Ciudad Obregón, Sonora" Foreground="#666666"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Usuario:" FontWeight="Bold" Foreground="#333333"/>
                        <TextBlock Grid.Column="1" Text="Administrador" Foreground="#666666"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Versión:" FontWeight="Bold" Foreground="#333333"/>
                        <TextBlock Grid.Column="1" Text="1.0.0" Foreground="#666666"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
