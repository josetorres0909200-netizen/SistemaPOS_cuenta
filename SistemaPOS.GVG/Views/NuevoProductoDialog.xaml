<Window x:Class="SistemaPOS.GVG.Views.NuevoProductoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Nuevo Producto" Height="400" Width="350" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Código de Barras:" FontWeight="Bold"/>
            <TextBox x:Name="txtCodigoBarras" Height="25" Padding="2"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Descripción (Ej. Esmalte Acrílico):" FontWeight="Bold"/>
            <TextBox x:Name="txtDescripcion" Height="25" Padding="2"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Categoría:" FontWeight="Bold"/>
            <ComboBox x:Name="cmbCategoria" Height="25">
                <ComboBoxItem Content="Esmaltes"/>
                <ComboBoxItem Content="Uretanos"/>
                <ComboBoxItem Content="Base Color"/>
                <ComboBoxItem Content="Transparentes"/>
                <ComboBoxItem Content="Consumibles"/>
            </ComboBox>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Precio Costo:" FontWeight="Bold"/>
                <TextBox x:Name="txtPrecioCosto" Height="25" Padding="2"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Precio Venta:" FontWeight="Bold"/>
                <TextBox x:Name="txtPrecioVenta" Height="25" Padding="2"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button x:Name="btnCancelar" Content="Cancelar" Width="80" Height="30" Margin="0,0,10,0" Click="btnCancelar_Click" Background="#FFDDDDDD"/>
            <Button x:Name="btnGuardar" Content="Guardar" Width="80" Height="30" Click="btnGuardar_Click" Background="#FF0078D7" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>