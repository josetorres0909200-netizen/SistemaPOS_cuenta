<Window x:Class="SistemaPOS.GVG.Views.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceso a Sucursal" Height="450" Width="350"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🚗 PINTURAS EL GORDO'S" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Acceso a Sucursal" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25"/>

        <TextBlock Grid.Row="2" Text="Usuario" Foreground="Gray" Margin="0,0,0,2"/>
        <TextBox x:Name="txtUsername" Grid.Row="2" Height="35" Margin="0,20,0,15" 
                 VerticalContentAlignment="Center" Padding="5,0"/>

        <TextBlock Grid.Row="3" Text="Contraseña" Foreground="Gray" Margin="0,0,0,2"/>
        <PasswordBox x:Name="txtPassword" Grid.Row="3" Height="35" Margin="0,20,0,25" 
                     VerticalContentAlignment="Center" Padding="5,0"/>

        <Button x:Name="btnIngresar" Grid.Row="4" Height="40" Click="btnIngresar_Click" 
                Foreground="White" FontSize="16" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0">
            <Button.Background>
                <SolidColorBrush Color="#C62828"/>
            </Button.Background>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            Iniciar Sesión
        </Button>
    </Grid>
</Window>