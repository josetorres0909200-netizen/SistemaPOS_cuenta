<Window x:Class="SistemaPOS.Desktop.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinturas El Gordo's - Panel Principal" Height="768" Width="1024"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="#F0F2F5">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111111">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="Menú Principal" Foreground="Gray" FontSize="12" Margin="15,0,0,10" FontWeight="SemiBold"/>

                <Button x:Name="btnMenuInicio" Content="🏠 Inicio" Height="45" Background="#E5A93A" Foreground="Black" FontWeight="Bold" HorizontalContentAlignment="Left" Padding="20,0,0,0" BorderThickness="0" Margin="0,5,0,0" Click="BtnMenuInicio_Click"/>
                <Button x:Name="btnMenuVentas" Content="🛒 Ventas" Click="btnMenuVentas_Click" Height="45" Background="Transparent" Foreground="White" HorizontalContentAlignment="Left" Padding="20,0,0,0" BorderThickness="0"/>
                <Button x:Name="btnMenuInventario" Content="📋 Inventario" Click="BtnMenuInventario_Click" Height="45" Background="Transparent" Foreground="White" HorizontalContentAlignment="Left" Padding="20,0,0,0" BorderThickness="0"/>
                <Button x:Name="btnMenuClientes" Content="👥 Clientes" Click="BtnMenuClientes_Click" Height="45" Background="Transparent" Foreground="White" HorizontalContentAlignment="Left" Padding="20,0,0,0" BorderThickness="0"/>

                <TextBlock Text="Administración" Foreground="Gray" FontSize="12" Margin="15,20,0,10" FontWeight="SemiBold"/>
                <Button x:Name="btnMenuCaja" Content="💵 Caja" Height="45" Background="Transparent" Foreground="White" HorizontalContentAlignment="Left" Padding="20,0,0,0" BorderThickness="0" Click="BtnMenuCaja_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="¡Bienvenido, admin!" FontSize="28" FontWeight="Bold" Foreground="#333333"/>
                <TextBlock Text="- CAJA-01 (Ciudad Obregón)" FontSize="24" Foreground="#666666" Margin="10,4,0,0"/>
            </StackPanel>

            <ContentControl x:Name="AreaTrabajoMain" Grid.Row="1" Margin="0,10,0,0" />
        </Grid>
    </Grid>
</Window>